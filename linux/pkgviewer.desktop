[Desktop Entry]
Type=Application
Name=PKG Viewer
Comment=View PS2/PS3/PS4/PS5/Switch/Xbox 360/Wii U package contents
Exec=pkgviewer %F
Icon=pkgviewer
Terminal=false
Categories=Utility;Game;
StartupWMClass=PKG Viewer
MimeType=application/x-pkgviewer-pkg;application/x-pkgviewer-exfat;application/x-pkgviewer-ffpfsc;application/x-pkgviewer-ffpkg;application/x-pkgviewer-nsp;application/x-pkgviewer-xci;
